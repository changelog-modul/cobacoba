-- ========================
-- PRIORITY LOOP
-- ========================

task.spawn(function()
 while true do
  task.wait(0.3)

  local gameFolder = workspace:FindFirstChild("GameFolder")
  if not gameFolder then continue end
  
  local brainrots = gameFolder:FindFirstChild("Brainrots")
  if not brainrots then continue end

  local godly = brainrots:FindFirstChild("Godly")
  local celestial = brainrots:FindFirstChild("Celestial")
  local secret = brainrots:FindFirstChild("Secret")

  -- 1️⃣ GODLY FIRST
  if godlyEnabled and godly and #godly:GetChildren() > 0 then
   teleportToFolder(godly)

  -- 2️⃣ CELESTIAL SECOND
  elseif celestialEnabled and celestial and #celestial:GetChildren() > 0 then
   teleportToFolder(celestial)

  -- 3️⃣ SECRET LAST
  elseif autoSecret and secret and #secret:GetChildren() > 0 then
   teleportToFolder(secret)
  end
 end
end)
