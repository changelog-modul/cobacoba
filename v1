-- ========================
-- SERVICES
-- ========================

local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ========================
-- LOAD RAYFIELD
-- ========================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
	Name = "Brainrot Teleport",
	LoadingTitle = "Brainrot Hub",
	LoadingSubtitle = "Priority Edition",
	ConfigurationSaving = {
		Enabled = false
	}
})

local Tab = Window:CreateTab("Main", 4483362458)

-- ========================
-- FUNCTIONS
-- ========================

local function getHRP()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:WaitForChild("HumanoidRootPart")
end

local function teleportToFolder(folder)
	if not folder then return end
	
	for _, model in pairs(folder:GetChildren()) do
		if model:IsA("Model") and model:FindFirstChild("RootPart") then
			getHRP().CFrame = model.RootPart.CFrame + Vector3.new(0,3,0)
			return
		end
	end
end

-- ========================
-- VARIABLES
-- ========================

local autoSecret = false
local celestialEnabled = false
local godlyEnabled = false

-- ========================
-- TOGGLES
-- ========================

Tab:CreateToggle({
	Name = "Auto Secret",
	CurrentValue = false,
	Callback = function(Value)
		autoSecret = Value
	end,
})

Tab:CreateToggle({
	Name = "Auto Celestial",
	CurrentValue = false,
	Callback = function(Value)
		celestialEnabled = Value
	end,
})

Tab:CreateToggle({
	Name = "Auto Godly (Priority)",
	CurrentValue = false,
	Callback = function(Value)
		godlyEnabled = Value
	end,
})

-- ========================
-- PRIORITY LOOP
-- ========================

task.spawn(function()
	while true do
		task.wait(1)

		local gameFolder = workspace:FindFirstChild("GameFolder")
		if not gameFolder then continue end
		
		local brainrots = gameFolder:FindFirstChild("Brainrots")
		if not brainrots then continue end

		local godly = brainrots:FindFirstChild("Godly")
		local celestial = brainrots:FindFirstChild("Celestial")
		local secret = brainrots:FindFirstChild("Secret")

		-- 1️⃣ GODLY FIRST
		if godlyEnabled and godly and #godly:GetChildren() > 0 then
			teleportToFolder(godly)

		-- 2️⃣ CELESTIAL SECOND
		elseif celestialEnabled and celestial and #celestial:GetChildren() > 0 then
			teleportToFolder(celestial)

		-- 3️⃣ SECRET LAST
		elseif autoSecret and secret and #secret:GetChildren() > 0 then
			teleportToFolder(secret)
		end
	end
end)
