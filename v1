local function getHRP()
 local char = player.Character or player.CharacterAdded:Wait()
 return char:WaitForChild("HumanoidRootPart")
end

local function teleportToSpawn()
 local spawn = workspace:FindFirstChild("SpawnLocation", true)
 if spawn and spawn:IsA("BasePart") then
  getHRP().CFrame = spawn.CFrame + Vector3.new(0,3,0)
 end
end

local function interactWithPrompt(prompt)
 if not prompt then return false end

 local holdTime = prompt.HoldDuration > 0 and prompt.HoldDuration or 0.3

 VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
 task.wait(holdTime)
 VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

 return true
end

local function triggerProximityPrompt(model)
 if not model then return false end
 
 local root = model:FindFirstChild("RootPart")
 if not root then return false end
 
 local prompt = root:FindFirstChildOfClass("ProximityPrompt")
 if not prompt then return false end
 
 getHRP().CFrame = root.CFrame + Vector3.new(0,2,0)
 task.wait(0.15)

 interactWithPrompt(prompt)
 task.wait(0.2)

 pcall(function()
  fireproximityprompt(prompt)
 end)

 return true
end

local function teleportToFolder(folder)
 if not folder then return end
 
 for _, model in pairs(folder:GetChildren()) do
  if model:IsA("Model") and model:FindFirstChild("RootPart") then
   
   getHRP().CFrame = model.RootPart.CFrame + Vector3.new(0,2,0)
   task.wait(0.2)
   
   local interacted = triggerProximityPrompt(model)
   task.wait(0.3)
   
   if interacted then
    teleportToSpawn()
   end
   
   return
  end
 end
end

-- ========================
-- SERVER HOP FUNCTION
-- ========================

local function serverHop()
 local req = game:HttpGet(
  "https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
 )
 
 local data = HttpService:JSONDecode(req)
 local servers = {}

 for _, v in pairs(data.data) do
  if v.playing < v.maxPlayers and v.id ~= game.JobId then
   table.insert(servers, v.id)
  end
 end

 if #servers > 0 then
  TeleportService:TeleportToPlaceInstance(
   PlaceId,
   servers[math.random(1,#servers)],
   player
  )
 end
end

