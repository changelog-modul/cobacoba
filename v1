local Players = game:GetService("Players")
local VirtualInputManager = game:GetService("VirtualInputManager")
local player = Players.LocalPlayer

-- ========================
-- LOAD RAYFIELD
-- ========================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
 Name = "Brainrot Teleport",
 LoadingTitle = "Brainrot Hub",
 LoadingSubtitle = "Priority Edition",
 ConfigurationSaving = {
  Enabled = false
 }
})

local Tab = Window:CreateTab("Main", 4483362458)

-- ========================
-- FUNCTIONS
-- ========================

local function getHRP()
 local char = player.Character or player.CharacterAdded:Wait()
 return char:WaitForChild("HumanoidRootPart")
end

local function teleportToSpawn()
 local spawn = workspace:FindFirstChild("SpawnLocation", true)
 if spawn and spawn:IsA("BasePart") then
  getHRP().CFrame = spawn.CFrame + Vector3.new(0,3,0)
 end
end

-- 🔹 INTERACT VIA VIRTUAL INPUT
local function interactWithPrompt(prompt)
 if not prompt then return false end

 local character = player.Character or player.CharacterAdded:Wait()
 local hrp = character:WaitForChild("HumanoidRootPart")

 if prompt.Parent and prompt.Parent:IsA("BasePart") then
  local distance = (hrp.Position - prompt.Parent.Position).Magnitude
  if distance > prompt.MaxActivationDistance then
   return false
  end
 end

 local holdTime = prompt.HoldDuration > 0 and prompt.HoldDuration or 0.3

 -- simulasi tekan E
 VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
 task.wait(holdTime + 0)
 VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

 return true
end

-- 🔹 TRIGGER PROMPT (VIRTUAL INPUT + FIREPROXIMITYPROMPT)
local function triggerProximityPrompt(model)
 if not model then return false end
 
 local root = model:FindFirstChild("RootPart")
 if not root then return false end
 
 local prompt = root:FindFirstChildOfClass("ProximityPrompt")
 if not prompt then return false end
 
 -- teleport dekat dulu
 getHRP().CFrame = root.CFrame + Vector3.new(0,2,0)
 task.wait(0.1)

 -- Virtual input dulu (biar kayak manual)
 interactWithPrompt(prompt)
 task.wait(0.2)

 -- backup pakai fireproximityprompt
 pcall(function()
  fireproximityprompt(prompt)
 end)

 return true
end

local function teleportToFolder(folder)
 if not folder then return end
 
 for _, model in pairs(folder:GetChildren()) do
  if model:IsA("Model") and model:FindFirstChild("RootPart") then
   
   local root = model.RootPart
   
   getHRP().CFrame = root.CFrame + Vector3.new(0,2,0)
   task.wait(0.2)
   
   local interacted = triggerProximityPrompt(model)
   task.wait(0.2)
   
   if interacted then
    teleportToSpawn()
   end
   
   return
  end
 end
end

