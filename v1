-- ========================

local function serverHop()
 if getgenv().LastJobId == game.JobId then
  task.wait(2) -- kalau balik ke server sama, tunggu lalu hop lagi
 end
 
 getgenv().LastJobId = game.JobId
 TeleportService:Teleport(PlaceId)
end

