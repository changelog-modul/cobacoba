local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ========================
-- UI SETUP (Wind Style)
-- ========================

local gui = Instance.new("ScreenGui")
gui.Name = "BrainrotUI"
gui.Parent = player:WaitForChild("PlayerGui")

local main = Instance.new("Frame", gui)
main.Size = UDim2.new(0,260,0,190)
main.Position = UDim2.new(0,60,0,200)
main.BackgroundColor3 = Color3.fromRGB(20,20,20)
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
Instance.new("UICorner", main).CornerRadius = UDim.new(0,14)

local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1,0,0,40)
title.BackgroundTransparency = 1
title.Text = "Brainrot Teleport"
title.Font = Enum.Font.GothamBold
title.TextColor3 = Color3.new(1,1,1)
title.TextScaled = true

-- ========================
-- FUNCTIONS
-- ========================

local function getHRP()
	local char = player.Character or player.CharacterAdded:Wait()
	return char:WaitForChild("HumanoidRootPart")
end

local function teleportToSpawn()
	local spawn = workspace:FindFirstChild("SpawnLocation")
	if spawn then
		getHRP().CFrame = spawn.CFrame + Vector3.new(0,3,0)
	end
end

local function teleportToBrainrot()
	local gameFolder = workspace:FindFirstChild("GameFolder")
	if not gameFolder then return end
	
	local brainrots = gameFolder:FindFirstChild("Brainrots")
	if not brainrots then return end
	
	local secret = brainrots:FindFirstChild("Secret")
	if not secret then return end
	
	for _, model in pairs(secret:GetChildren()) do
		if model:IsA("Model") and model:FindFirstChild("RootPart") then
			getHRP().CFrame = model.RootPart.CFrame + Vector3.new(0,3,0)
			return
		end
	end
end

-- ========================
-- BUTTON: TELEPORT SPAWN
-- ========================

local spawnBtn = Instance.new("TextButton", main)
spawnBtn.Size = UDim2.new(0.9,0,0,40)
spawnBtn.Position = UDim2.new(0.05,0,0,55)
spawnBtn.Text = "Teleport To Spawn"
spawnBtn.Font = Enum.Font.Gotham
spawnBtn.TextScaled = true
spawnBtn.TextColor3 = Color3.new(1,1,1)
spawnBtn.BackgroundColor3 = Color3.fromRGB(35,35,35)
Instance.new("UICorner", spawnBtn).CornerRadius = UDim.new(0,10)

spawnBtn.MouseButton1Click:Connect(function()
	teleportToSpawn()
end)

-- ========================
-- TOGGLE AUTO BRAINROT
-- ========================

local autoEnabled = false

local toggleBtn = Instance.new("TextButton", main)
toggleBtn.Size = UDim2.new(0.9,0,0,40)
toggleBtn.Position = UDim2.new(0.05,0,0,110)
toggleBtn.Text = "Auto Brainrot: OFF"
toggleBtn.Font = Enum.Font.Gotham
toggleBtn.TextScaled = true
toggleBtn.TextColor3 = Color3.new(1,1,1)
toggleBtn.BackgroundColor3 = Color3.fromRGB(35,35,35)
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0,10)

toggleBtn.MouseButton1Click:Connect(function()
	autoEnabled = not autoEnabled
	
	if autoEnabled then
		toggleBtn.Text = "Auto Brainrot: ON"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60,120,60)
	else
		toggleBtn.Text = "Auto Brainrot: OFF"
		toggleBtn.BackgroundColor3 = Color3.fromRGB(35,35,35)
	end
end)

-- ========================
-- AUTO DETECT LOOP
-- ========================

task.spawn(function()
	while true do
		task.wait(1)
		
		if autoEnabled then
			local secretFolder = workspace:FindFirstChild("GameFolder")
			if secretFolder then
				secretFolder = secretFolder:FindFirstChild("Brainrots")
			end
			if secretFolder then
				secretFolder = secretFolder:FindFirstChild("Secret")
			end
			
			if secretFolder and #secretFolder:GetChildren() > 0 then
				teleportToBrainrot()
			end
		end
	end
end)
