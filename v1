-- ========================
-- PRIORITY TELEPORT LOOP
-- ========================

task.spawn(function()
 while true do
  task.wait(0.3)

  local gameFolder = workspace:FindFirstChild("GameFolder")
  if not gameFolder then continue end
  
  local brainrots = gameFolder:FindFirstChild("Brainrots")
  if not brainrots then continue end

  local godly = brainrots:FindFirstChild("Godly")
  local celestial = brainrots:FindFirstChild("Celestial")
  local secret = brainrots:FindFirstChild("Secret")

  if getgenv().GodlyEnabled and godly and #godly:GetChildren() > 0 then
   teleportToFolder(godly)

  elseif getgenv().CelestialEnabled and celestial and #celestial:GetChildren() > 0 then
   teleportToFolder(celestial)

  elseif getgenv().AutoSecret and secret and #secret:GetChildren() > 0 then
   teleportToFolder(secret)
  end
 end
end)

-- ========================
-- AUTO SERVER HOP SYSTEM
-- ========================

task.spawn(function()
 while true do
  task.wait(5)

  if not getgenv().ServerHopEnabled then continue end

  local gameFolder = workspace:FindFirstChild("GameFolder")
  local brainrots = gameFolder and gameFolder:FindFirstChild("Brainrots")

  local godly = brainrots and brainrots:FindFirstChild("Godly")
  local celestial = brainrots and brainrots:FindFirstChild("Celestial")

  local foundGodly = godly and #godly:GetChildren() > 0
  local foundCelestial = celestial and #celestial:GetChildren() > 0

  if getgenv().GodlyHop then
   if not foundGodly then
    serverHop()
   end

  elseif getgenv().CelestialHop then
   if not foundCelestial then
    serverHop()
   end
  end
 end
end)
