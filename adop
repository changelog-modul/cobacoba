-- Get currently focused pet
function getFocusedPet()
    local focusApp = UIManager and UIManager.apps and UIManager.apps.FocusPetApp
    if focusApp and focusApp.char_wrapper then
        local pet = {}
        pet.char = focusApp.char_wrapper
        pet.pet_unique = focusApp.char_wrapper:GetAttribute("pet_unique")
        pet.pet_id = focusApp.char_wrapper:GetAttribute("pet_id")
        pet.pet_trick_level = focusApp.char_wrapper:GetAttribute("trick_level") or 1
        return pet
    end
    
    -- Try to get from inventory
    local pets = ClientData and ClientData.get and ClientData.get("inventory").pets
    if pets then
        for _, pet in pairs(pets) do
            return pet
        end
    end
    return nil
end

-- Spawn item
function spawnItem(itemId)
    local playerChar = LocalPlayer.Character
    if playerChar then
        local cframe = playerChar.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
        
        -- Create item object
        local item = Instance.new("Part")
        item.Name = itemId
        item.Size = Vector3.new(2, 2, 2)
        item.CFrame = cframe
        item.BrickColor = BrickColor.new("Bright red")
        item.Material = Enum.Material.Neon
        item.Anchored = true
        item.CanCollide = false
        item.Parent = workspace
        
        -- Add to inventory via data injection
        local inventory = ClientData.get("inventory")
        if inventory and inventory.food then
            table.insert(inventory.food, {
                id = itemId,
                unique = HttpService:GenerateGUID(false),
                amount = 999
            })
        end
        
        Rayfield:Notify({
            Title = "Item Spawned",
            Content = itemId .. " spawned at your location!",
            Duration = 3
        })
        
        -- Remove after 10 seconds
        task.delay(10, function()
            item:Destroy()
        end)
    end
end

