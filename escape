-- ===========================================
-- FUNGSI TIMER FREEZE
-- ===========================================
local function applyTimerFreeze()
    if not TowerObjects.billboard then return end
    
    -- Cari elemen timer
    local trialTimer = TowerObjects.billboard:FindFirstChild("Frame"):FindFirstChild("Info"):FindFirstChild("TrialTimerContainer")
    if trialTimer then
        local timeLabel = trialTimer:FindFirstChild("TimeLabel")
        if timeLabel then
            -- Hook ke property Text biar selalu nampilin waktu tetap
            local mt = getrawmetatable(game)
            local old = mt.__newindex
            setreadonly(mt, false)
            
            mt.__newindex = function(t, k, v)
                if t == timeLabel and k == "Text" then
                    -- Selalu set ke "99:99" atau frozen
                    return old(t, k, "99:99")
                end
                return old(t, k, v)
            end
            
            setreadonly(mt, true)
        end
    end
end

