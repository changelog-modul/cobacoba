-- ===========================================
-- FUNGSI WAIT FOR TOWER
-- ===========================================
local function waitForTower()
    local CollectionService = game:GetService("CollectionService")
    
    -- Coba cari yang sudah ada
    if findTower() then
        return true
    end
    
    -- Tunggu sampai tower muncul
    print("⏳ Menunggu tower muncul...")
    local timeout = 30
    local start = os.clock()
    
    while os.clock() - start < timeout do
        if findTower() then
            print("✅ Tower ditemukan setelah menunggu")
            return true
        end
        task.wait(1)
    end
    
    print("❌ Tower tidak ditemukan dalam 30 detik")
    return false
end

-- ===========================================
-- FUNGSI REMOTE SPOOFING
-- ===========================================
local function getRemotes()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local remotes = {}
    
    -- Coba dapatkan dari Shared.Remotes
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    if shared then
        local remotesModule = shared:FindFirstChild("Remotes")
        if remotesModule then
            -- Ini adalah module, kita perlu require
            local success, result = pcall(function()
                return require(remotesModule)
            end)
            if success and type(result) == "table" then
                remotes = result
            end
        end
    end
    
    -- Fallback: cari remote langsung
    if not next(remotes) then
        for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                if string.find(child.Name, "Tower") then
                    remotes[child.Name] = child
                end
            end
        end
    end
    
    return remotes
end

-- ===========================================
-- FUNGSI GET TOWER STATE
-- ===========================================
local function getTowerState()
    local remotes = getRemotes()
    
    -- Coba panggil remote untuk get state
    for name, remote in pairs(remotes) do
        if string.find(name, "TowerState") or string.find(name, "GetTowerState") then
            if remote:IsA("RemoteFunction") then
                local success, result = pcall(function()
                    return remote:InvokeServer()
                end)
                if success and result then
                    return result
                end
            elseif remote:IsA("RemoteEvent") then
                -- Untuk RemoteEvent kita perlu hook atau cara lain
                -- Ini lebih kompleks, skip dulu
            end
        end
    end
    
    return nil
end

