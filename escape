-- ✅ DAFTAR LUCKY BLOCK YANG DIIZINKAN
local allowedBlocks = {
    ["celestial"] = true,
    ["divine"] = true,
    ["infinity"] = true,
    ["radio active"] = true,
    ["radioactive"] = true,
    ["ufo"] = true,
    ["money"] = true,
    ["gamer"] = true,
    ["candy"] = true,
    ["alien"] = true,
    ["jackpot"] = true,
    ["arcade"] = true,
    ["sugar rush"] = true,
    ["sugarrush"] = true,
    ["admin"] = true,
}

-- 🔎 FUNCTION CEK APAKAH NAMA MASUK FILTER
local function isAllowedBlock(name)
    name = string.lower(name)
    for allowedName, _ in pairs(allowedBlocks) do
        if string.find(name, allowedName, 1, true) then
            return true
        end
    end
    return false
end

-- 🔎 SCAN LUCKY BLOCK DENGAN FILTER
local function scanLuckyBlocks()
    luckyBlocksList = {}
    
    if not targetFolder then
        targetFolder = workspace:FindFirstChild("ActiveLuckyBlocks")
        if not targetFolder then
            print("❌ Folder ActiveLuckyBlocks tidak ditemukan!")
            return 0
        end
    end
    
    local count = 0
    
    for _, block in pairs(targetFolder:GetChildren()) do
        
        -- ✅ FILTER NAMA BLOCK
        if isAllowedBlock(block.Name) then
            
            -- Cek RootPart
            local rootPart = block:FindFirstChild("RootPart")
            if rootPart then
                local prompt = rootPart:FindFirstChildOfClass("ProximityPrompt")
                if prompt and prompt.Enabled then
                    table.insert(luckyBlocksList, {
                        name = block.Name,
                        block = block,
                        rootPart = rootPart,
                        prompt = prompt,
                        position = rootPart.Position
                    })
                    count = count + 1
                    print("✅ (FILTERED) Ditemukan:", block.Name)
                end
            end
            
            -- Cek child lain
            for _, child in pairs(block:GetChildren()) do
                if child:IsA("BasePart") then
                    local prompt = child:FindFirstChildOfClass("ProximityPrompt")
                    if prompt and prompt.Enabled then
                        table.insert(luckyBlocksList, {
                            name = block.Name .. " - " .. child.Name,
                            block = block,
                            rootPart = child,
                            prompt = prompt,
                            position = child.Position
                        })
                        count = count + 1
                        print("✅ (FILTERED) Ditemukan:", block.Name, "-", child.Name)
                    end
                end
            end
        else
            -- Kalau tidak masuk filter
            -- print("❌ Di-skip:", block.Name)
        end
    end
    
    print("📊 Total lucky block sesuai filter:", count)
    return count
end

-- ===========================================
-- FUNGSI TERBANG CEPAT KE POSISI
-- ===========================================
local function flyToPosition(targetPos, speed)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    -- Hitung jarak
    local distance = (targetPos - rootPart.Position).Magnitude
    local flyTime = distance / speed
    
    print("🚀 Terbang ke target, jarak:", math.floor(distance), "studs, estimasi:", math.floor(flyTime * 100) / 100, "detik")
    
    -- Pake Tween biar halus
    local tweenInfo = TweenInfo.new(
        flyTime,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )
    
    local goal = {
        CFrame = CFrame.new(targetPos.X, -2, targetPos.Z) -- Force Y = -2
    }
    
    local tween = TweenService:Create(rootPart, tweenInfo, goal)
    tween:Play()
    
    -- Tunggu sampe nyampe
    tween.Completed:Wait()
    
    -- Pastikan Y = -2
    task.wait(0.1)
    rootPart.CFrame = CFrame.new(targetPos.X, -2, targetPos.Z)
    
    return true
end

