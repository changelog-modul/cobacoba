local function createESP(part, name, color)
    if not part then return nil end
    
    -- Bersihkan ESP lama
    if TowerESP[part] then
        pcall(function() TowerESP[part]:Destroy() end)
        TowerESP[part] = nil
    end
    
    -- Buat BillboardGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "TowerESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 0.3
    frame.BackgroundColor3 = color or Color3.new(1, 0, 0)
    frame.Parent = billboard
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = name or "Tower"
    text.TextColor3 = Color3.new(1, 1, 1)
    text.TextStrokeTransparency = 0.5
    text.TextStrokeColor3 = Color3.new(0, 0, 0)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 16
    text.Parent = frame
    
    billboard.Parent = game:GetService("CoreGui")
    
    TowerESP[part] = billboard
    return billboard
end

local function toggleTowerESP(enable)
    if enable then
        if TowerObjects.model and TowerObjects.model.PrimaryPart then
            createESP(TowerObjects.model.PrimaryPart, "🏰 TOWER", Color3.new(1, 0, 0))
            
            if TowerObjects.center then
                createESP(TowerObjects.center, "📍 CENTER", Color3.new(0, 1, 0))
            end
            
            if TowerObjects.resultSpawn then
                createESP(TowerObjects.resultSpawn, "🎁 RESULT", Color3.new(0, 0, 1))
            end
        end
        
        -- ESP untuk brainrot di sekitar
        local CollectionService = game:GetService("CollectionService")
        local brainrots = CollectionService:GetTagged("Brainrot")
        
        for _, brainrot in ipairs(brainrots) do
            if brainrot.PrimaryPart then
                createESP(brainrot.PrimaryPart, "🧠 " .. brainrot.Name, Color3.new(1, 1, 0))
            end
        end
    else
        for _, esp in pairs(TowerESP) do
            pcall(function() esp:Destroy() end)
        end
        table.clear(TowerESP)
    end
end

