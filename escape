--// Cache prompt biar tidak scan terus
local prompts = {}

local function addPrompt(obj)
    if obj:IsA("ProximityPrompt") then
        table.insert(prompts, obj)
    end
end

local function removePrompt(obj)
    for i,v in ipairs(prompts) do
        if v == obj then
            table.remove(prompts, i)
            break
        end
    end
end

-- isi awal
