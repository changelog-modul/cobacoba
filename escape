-- FUNGSI TOWER FARM LOOP
-- ===========================================
local function startTowerFarm()
    if TowerActive then return end
    
    -- Cari tower dulu
    if not TowerObjects.model then
        if not waitForTower() then
            print("❌ Gagal menemukan tower")
            return
        end
    end
    
    TowerActive = true
    print("🏰 TOWER FARM DIMULAI!")
    
    -- Loop utama
    spawn(function()
        while TowerActive do
            task.wait(1)
            
            if not TowerObjects.model then
                findTower()
            end
            
            -- Apply berbagai fitur
            if TowerAntiCooldown then
                applyAntiCooldown()
            end
            
            if TowerTimerFreeze then
                applyTimerFreeze()
            end
            
            setInfiniteCombo()
            
            -- Auto submit
            if TowerAutoSubmit then
                autoSubmitBrainrot()
            end
            
            -- Auto complete
            if TowerAutoComplete and TowerState.phase == "trial" then
                -- Cek apakah sudah memenuhi syarat
                if #TowerState.brought >= 3 then -- MinDeposits
                    autoCompleteTrial()
                end
            end
            
            -- Auto claim
            if TowerAutoClaim and TowerState.phase == "complete" then
                autoClaimReward()
            end
            
            -- Remote spoofing untuk bypass requirement
            if TowerState.phase == "trial" and TowerState.requirement then
                -- Force UI untuk menerima brainrot apapun
                if TowerObjects.billboard then
                    local requirementLabel = TowerObjects.billboard:FindFirstChild("Frame"):FindFirstChild("Info"):FindFirstChild("Requirement")
                    if requirementLabel then
                        requirementLabel.Visible = false
                    end
                end
            end
        end
    end)
end

