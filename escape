-- ===========================================
-- FUNGSI TRIGGER PROMPT
-- ===========================================
local function triggerPrompt(prompt, blockName)
    if not prompt then return false end
    
    local success = pcall(function()
        -- Set properties
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.RequireLineOfSight = false
        prompt.MaxActivationDistance = 9e9
        
        -- Naik dikit ke Y = -1 buat trigger (biar tepat di depan block)
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, 1, -2)
        end
        
        task.wait(0.1)
        
        -- Trigger pake berbagai method
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
        
        -- Remote events
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local remote = ReplicatedStorage:FindFirstChild("ProximityPromptRemote") or
                      ReplicatedStorage:FindFirstChild("PromptRemote") or
                      ReplicatedStorage:FindFirstChild("TriggerPrompt")
        if remote then
            remote:FireServer(prompt)
        end
        
        -- Kembali ke Y = -2
        task.wait(0.1)
        if character and character:FindFirstChild("HumanoidRootPart") then
            character.HumanoidRootPart.CFrame = CFrame.new(
                character.HumanoidRootPart.Position.X,
                -2,
                character.HumanoidRootPart.Position.Z
            )
        end
    end)
    
    if success then
        print("✅ Trigger berhasil:", blockName)
    else
        print("❌ Trigger gagal:", blockName)
    end
    
    return success
end

-- ===========================================
-- FUNGSI AUTO FARM LOOP
-- ===========================================
local function startAutoFarm()
    if autoFarmActive then return end
    
    -- Save spawn position
    if not spawnPosition then
        saveSpawnPosition()
    end
    
    -- Set Y = -2 + fly
    setYminus2()
    
    -- Scan lucky blocks
    local count = scanLuckyBlocks()
    if count == 0 then
        print("❌ Tidak ada lucky block ditemukan!")
        return
    end
    
    autoFarmActive = true
    currentBlockIndex = 1
    
    print("🚀 AUTO FARM DIMULAI!")
    
    -- Loop farming
    spawn(function()
        while autoFarmActive do
            -- Scan ulang setiap selesai 1 putaran
            if currentBlockIndex > #luckyBlocksList then
                print("📊 Scan ulang lucky blocks...")
                scanLuckyBlocks()
                currentBlockIndex = 1
                
                if #luckyBlocksList == 0 then
                    print("⏸️ Tidak ada lucky block, tunggu 5 detik...")
                    task.wait(5)
                    scanLuckyBlocks()
                end
            end
            
            -- Ambil block berikutnya
            local block = luckyBlocksList[currentBlockIndex]
            if block then
                print("\n🎯 Memproses:", block.name)
                
                -- Terbang ke posisi block (Y=-2)
                local targetPos = Vector3.new(block.position.X, -2, block.position.Z)
                flyToPosition(targetPos, 800) -- Speed 800 studs/detik
                
                -- Trigger prompt
                triggerPrompt(block.prompt, block.name)
                
                task.wait(0.5)

                -- Kembali ke spawn (Y=-2)
                if spawnPosition then
                    print("🏠 Kembali ke spawn...")
                    flyToPosition(Vector3.new(spawnPosition.X, -2, spawnPosition.Z), 800)
                end
                
                -- Lanjut ke block berikutnya
                currentBlockIndex = currentBlockIndex + 1
                
                -- Delay antar block
                task.wait(1)
            else
                currentBlockIndex = currentBlockIndex + 1
            end
        end
    end)
end

