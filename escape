-- ===========================================
-- FUNGSI SET Y = -2 + FLY
-- ===========================================
local function setYminus2()
    local character = LocalPlayer.Character
    if not character then
        character = LocalPlayer.CharacterAdded:Wait()
    end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- Set posisi Y = -2
    rootPart.CFrame = CFrame.new(rootPart.Position.X, -2, rootPart.Position.Z)
    
    -- Aktifkan fly biar ga jatuh
    if not flyActive then
        -- Matikan BodyVelocity lama kalo ada
        if bodyVelocity then
            pcall(function() bodyVelocity:Destroy() end)
            bodyVelocity = nil
        end
        
        -- Buat BodyVelocity baru
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
        bodyVelocity.Parent = rootPart
        
        flyActive = true
        
        -- Loop untuk maintain Y = -2
        flyConn = RunService.RenderStepped:Connect(function()
            if not flyActive or not autoFarmActive then return end
            
            local char = LocalPlayer.Character
            if not char then return end
            
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            
            -- Force posisi Y = -2 terus
            if math.abs(root.Position.Y + 2) > 0.5 then
                root.CFrame = CFrame.new(root.Position.X, -2, root.Position.Z)
            end
            
            -- Maintain velocity
            if bodyVelocity and bodyVelocity.Parent then
                bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    end
    
    -- Aktifkan noclip
    if not noclipActive then
        noclipActive = true
        noclipConn = RunService.Stepped:Connect(function()
            if not noclipActive or not autoFarmActive then return end
            
            local char = LocalPlayer.Character
            if not char then return end
            
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    end
    
    print("✅ Posisi Y = -2, fly aktif, noclip aktif")
end

