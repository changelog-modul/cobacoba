local function scanTowerState()
    if not TowerObjects.model then
        findTower()
    end
    
    local state = getTowerState()
    if state then
        TowerState = state
        print("📊 Tower State:", TowerState.phase)
        if TowerState.requirement then
            print("   Requirement:", TowerState.requirement)
        end
        print("   Deposits:", #TowerState.brought)
        print("   Combo:", TowerState.combo)
        return true
    else
        -- Fallback: baca dari UI
        if TowerObjects.billboard then
            local info = TowerObjects.billboard:FindFirstChild("Frame"):FindFirstChild("Info")
            if info then
                local infoText = info:FindFirstChild("InfoText")
                if infoText then
                    print("📊 Tower UI Text:", infoText.Text)
                end
                
                local requirement = info:FindFirstChild("Requirement")
                if requirement and requirement.Visible then
                    print("   Requirement visible")
                end
            end
        end
    end
    
    return false
end

